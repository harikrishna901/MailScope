# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MailCheck Pro Configuration
PORT=3000
CORS_ORIGIN="http://localhost:3000"
SMTP_ENABLED=false
SMTP_TIMEOUT_MS=8000
SMTP_HELO_HOST="example.invalid"
SMTP_MAIL_FROM="probe@example.invalid"
MAX_BATCH=100
DNS_SERVERS=8.8.8.8,1.1.1.1